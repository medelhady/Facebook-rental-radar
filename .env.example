NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apify — collection layer.
# APIFY_TASK_ID is the saved Task that holds the Facebook cookies and the
# residential proxy, not the Actor: a Schedule pointed at the Actor runs with
# an empty default input and scrapes nothing.
APIFY_TOKEN=
APIFY_TASK_ID=
APIFY_SCHEDULE_ID=
# Any long random string. Apify calls the webhook with ?secret=<this value>.
APIFY_WEBHOOK_SECRET=

# Shared password for the routes that carry a Facebook session (the cookie
# editor). Unset leaves them open, which is only safe on localhost.
ADMIN_TOKEN=
